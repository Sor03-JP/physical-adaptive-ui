{
  "name": "physical-adaptive-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace mock-app",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run check && npm run build --workspaces --if-present",
    "test": "vitest run",
    "dev:measurement": "npm run dev --workspace @physical-adaptive/experiment-app",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.59.2"
  }
}
